        object txtCaixaDialogoRU2: TIWText
          Left = 18
          Top = 4
          Width = 492
          Height = 226
          Cursor = crAuto
          IW50Hint = False
          ParentShowHint = False
          ShowHint = True
          ZIndex = 0
