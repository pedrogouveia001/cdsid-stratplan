          Font.FontFamily = 'Verdana, Helvetica, Sans-Serif'
          Font.Size = 10
          Font.Style = []
          FriendlyName = 'txtCaixaDialogoRU'
          Lines.Strings = (
            
              'By continuing, you will be redirected to the CDSID unified regis' +
              'tration system. '
            ''
            
              'You now have a single registration (email and password) to acces' +
              's all CDSID applications (FITradeoff, Promethee - ROC, SIDMCPM, ' +
              'etc...).'
            ''
            
              'For registration and data management, you must access <http://15' +
              '.229.155.120/CDSID-Access/>. Doing so will update your access cr' +
              'edentials in all applications.'
            ''
            
              'If you have any questions, please contact us at fitradeoff@cdsid' +
              '.org.br.')
          RawText = False
          UseFrame = False
          WantReturns = True
        end
